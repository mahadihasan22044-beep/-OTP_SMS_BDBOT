def run_broadcast(chat_id, original_message, msg_id):
    data = load_data()
    users = data.get("users", [])
    success, failed = 0, 0
    for u in users:
        try: bot.copy_message(chat_id=u, from_chat_id=chat_id, message_id=original_message.message_id); success += 1; time.sleep(0.05)
        except: failed += 1
    markup = InlineKeyboardMarkup().add(ibtn("🔙 BACK TO ADMIN", callback_data="back_to_admin", style="danger"))
    report = f"📢 <b>BROADCAST DONE!</b>\n\n✅ <b>SENT:</b> {success}\n❌ <b>FAILED:</b> {failed}"
    safe_send(chat_id, report, markup, msg_id)

def process_broadcast(message, msg_id):
    if check_cancel(message, msg_id, show_admin_panel): return
    try: bot.delete_message(message.chat.id, msg_id)
    except: pass
    load_msg = safe_send(message.chat.id, f"⏳ <b>BROADCASTING...</b>", None, None)
    threading.Thread(target=run_broadcast, args=(message.chat.id, message, load_msg.message_id if load_msg else None)).start()

# --- Multi-API, Multi-Number Core OTP Functions ---
def fetch_numbers_smart(chat_id, srv_id, srv_name, all_ranges, main_api_key, msg_id):
    active_polls[str(chat_id)] = True
    numbers_found = []
    api_keys = __get_all_api_keys(main_api_key)
    lang = get_user_lang(chat_id)
    
    random.shuffle(all_ranges) 
    service_code = get_service_code(srv_name)
    
    data = load_data()
    dynamic_max_nums = data.get("settings", {}).get("max_numbers", MAX_NUMBERS)
    
    for rng_data in all_ranges:
        if len(numbers_found) >= dynamic_max_nums: break
        cnt_id, c_name, r_id, r_val = rng_data
        clean_range = str(r_val).strip().replace(" ", "")
        
        status_txt = "⏳ WAITING"
        if lang == "bn": status_txt = "⏳ অপেক্ষায়"
        elif lang == "hi": status_txt = "⏳ प्रतीक्षा में"
        elif lang == "ur": status_txt = "⏳ انتظار میں"
            
        for _ in range(dynamic_max_nums - len(numbers_found)):
            success_here = False
            for key in api_keys:
                try:
                    payload = {"rid": clean_range}
                    res = requests.post(
                        f"{BASE_URL}/getnum",
                        json=payload,
                        headers={'mauthapi': key},
                        timeout=8
                    ).json()
                    if res.get("meta", {}).get("code") == 200:
                        numbers_found.append({
                            "number": res.get("data", {}).get("full_number", ""),
                            "number_id": res.get("rid", ""),
                            "api_key": key,
                            "status": status_txt,
                            "cnt_id": cnt_id,
                            "country_name": c_name,
                            "r_id": r_id,
                            "r_val": clean_range
                        })
                        success_here = True
                        break 
                except: pass
            
            if not success_here:
                break 
                
        if len(numbers_found) > 0:
            break 

    if not numbers_found:
        btn_back = "🔙 BACK"
        if lang == "bn": btn_back = "🔙 ফিরে যান"
        elif lang == "hi": btn_back = "🔙 वापस जाएं"
        elif lang == "ur": btn_back = "🔙 واپس جائیں"
            
        markup = InlineKeyboardMarkup().add(ibtn(btn_back, callback_data=f"usr_s|{srv_id}", style="danger"))
        if lang == "bn":
            err_msg = f"❌ <b>দুঃখিত, এই মুহূর্তে সমস্ত রেঞ্জ স্টক আউট।</b>\n{DIVIDER}\n<i>আমরা উপলব্ধ রেঞ্জগুলো চেক করেছি কিন্তু কোনো নাম্বার পাওয়া যায়নি। দয়া করে পরে আবার চেষ্টা করুন।</i>"
        elif lang == "hi":
            err_msg = f"❌ <b>क्षमा करें, इस समय सभी रेंज आउट ऑफ़ स्टॉक हैं।</b>\n{DIVIDER}\n<i>हमने उपलब्ध रेंज जांचीं लेकिन कोई नंबर नहीं मिला। कृपया बाद में प्रयास करें।</i>"
        elif lang == "ur":
            err_msg = f"❌ <b>معذرت، اس وقت تمام رینجز آؤٹ آف اسٹاک ہیں۔</b>\n{DIVIDER}\n<i>ہم نے دستیاب رینجز چیک کیں لیکن کوئی نمبر نہیں ملا۔ براہ کرم بعد میں کوشش کریں۔</i>"
        else:
            err_msg = f"❌ 𝗦𝗢𝗥𝗥𝗬, 𝗔𝗟𝗟 𝗥𝗔𝗡𝗚𝗘𝗦 𝗔𝗥𝗘 𝗢𝗨𝗧 𝗢𝗙 𝗦𝗧𝗢𝗖𝗞 𝗖𝗨𝗥𝗥𝗘𝗡𝗧𝗟𝗬.\n{DIVIDER}\n<i>We checked available ranges but couldn't find an active number. Please try again later.</i>"
            
        safe_send(chat_id, err_msg, markup, msg_id)
        active_polls[str(chat_id)] = False
        return

    watermark = data.get("watermark", BOT_NAME)
    
    final_country_name = clean_country_name(numbers_found[0]['country_name'])
    final_cnt_id = numbers_found[0]['cnt_id']
    final_r_id = numbers_found[0]['r_id']
    
    flag = get_country_flag(final_country_name, premium=True)
    srv_emoji = emo(srv_name)
    
    if lang == "bn":
        text = f"{PR_GEM} <b>নাম্বার বরাদ্দ হয়েছে</b> {PR_GEM}\n{DIVIDER}\n{srv_emoji} <b>সার্ভিস:</b> <b>{html.escape(srv_name.upper())}</b>\n{flag} <b>দেশ:</b> <b>{html.escape(final_country_name.upper())}</b>\n{DIVIDER}\n"
    elif lang == "hi":
        text = f"{PR_GEM} <b>नंबर आवंटित किया गया</b> {PR_GEM}\n{DIVIDER}\n{srv_emoji} <b>सर्विस:</b> <b>{html.escape(srv_name.upper())}</b>\n{flag} <b>देश:</b> <b>{html.escape(final_country_name.upper())}</b>\n{DIVIDER}\n"
    elif lang == "ur":
        text = f"{PR_GEM} <b>نمبر الاٹ کر دیا گیا</b> {PR_GEM}\n{DIVIDER}\n{srv_emoji} <b>سروس:</b> <b>{html.escape(srv_name.upper())}</b>\n{flag} <b>ملک:</b> <b>{html.escape(final_country_name.upper())}</b>\n{DIVIDER}\n"
    else:
        text = f"{PR_GEM} <b>NUMBER ALLOCATED</b> {PR_GEM}\n{DIVIDER}\n{srv_emoji} <b>SERVICE:</b> <b>{html.escape(srv_name.upper())}</b>\n{flag} <b>COUNTRY:</b> <b>{html.escape(final_country_name.upper())}</b>\n{DIVIDER}\n"
        
    for i, num_data in enumerate(numbers_found):
        raw_num = str(num_data['number']).replace('+', '')
        text += f"{i+1}️⃣ <code>+{raw_num}</code>  {num_data['status']}\n"
    text += f"{DIVIDER}\n{PR_FIRE} <b>{html.escape(watermark.upper())}</b> {PR_FIRE}"
    
    main_link = format_url(data.get("main_otp_link", "https://t.me/"))
    markup = InlineKeyboardMarkup(row_width=2)
    
    btn_chg = "🔄 CHANGE"
    btn_otp = "📨 OTP GROUP"
    btn_back = "🔙 BACK"
    
    if lang == "bn":
        btn_chg = "🔄 পরিবর্তন করুন"
        btn_otp = "📨 ওটিপি গ্রুপ"
        btn_back = "🔙 ফিরে যান"
    elif lang == "hi":
        btn_chg = "🔄 बदलें"
        btn_otp = "📨 OTP ग्रुप"
        btn_back = "🔙 वापस जाएं"
    elif lang == "ur":
        btn_chg = "🔄 تبدیل کریں"
        btn_otp = "📨 OTP گروپ"
        btn_back = "🔙 واپس جائیں"
    
    markup.add(ibtn(btn_chg, callback_data=f"chg_r|{srv_id}|{final_cnt_id}|{final_r_id}", style="primary"), ibtn(btn_otp, url=main_link, style="success"))
    markup.add(ibtn(btn_back, callback_data=f"usr_s|{srv_id}", style="danger"))
    
    service_info = {
        'id': final_r_id, 'srv_id': srv_id, 'cnt_id': final_cnt_id, 
        'service_name': srv_name, 'country_name': final_country_name, 'range': numbers_found[0]['r_val']
    }
    
    active_polls[str(chat_id)] = {"numbers": numbers_found, "service_info": service_info, "message_id": msg_id, "watermark": watermark, "main_link": main_link, "lang": lang}
    safe_send(chat_id, text, markup, msg_id)
    
    for num_data in numbers_found:
        threading.Thread(target=poll_otp, args=(chat_id, num_data, service_info)).start()

def update_number_status(chat_id, phone_number, status_text, emoji_status):
    if str(chat_id) not in active_polls or not active_polls[str(chat_id)]: return
    poll_data = active_polls[str(chat_id)]
    numbers = poll_data.get("numbers", [])
    message_id = poll_data.get("message_id")
    service_info = poll_data.get("service_info", {})
    watermark = poll_data.get("watermark", BOT_NAME)
    main_link = poll_data.get("main_link", "https://t.me/")
    lang = poll_data.get("lang", "en")
    
    for num_data in numbers:
        if num_data["number"] == phone_number: num_data["status"] = f"{emoji_status} {status_text}"; break
    
    safe_country = clean_country_name(service_info.get('country_name', ''))
    flag = get_country_flag(safe_country, premium=True)
    srv_emoji = emo(service_info.get('service_name', ''))
    
    if lang == "bn":
        text = f"{PR_GEM} <b>নাম্বার বরাদ্দ হয়েছে</b> {PR_GEM}\n{DIVIDER}\n{srv_emoji} <b>সার্ভিস:</b> <b>{html.escape(service_info.get('service_name', '').upper())}</b>\n{flag} <b>দেশ:</b> <b>{html.escape(safe_country.upper())}</b>\n{DIVIDER}\n"
    elif lang == "hi":
        text = f"{PR_GEM} <b>नंबर आवंटित किया गया</b> {PR_GEM}\n{DIVIDER}\n{srv_emoji} <b>सर्विस:</b> <b>{html.escape(service_info.get('service_name', '').upper())}</b>\n{flag} <b>देश:</b> <b>{html.escape(safe_country.upper())}</b>\n{DIVIDER}\n"
    elif lang == "ur":
        text = f"{PR_GEM} <b>نمبر الاٹ کر دیا گیا</b> {PR_GEM}\n{DIVIDER}\n{srv_emoji} <b>سروس:</b> <b>{html.escape(service_info.get('service_name', '').upper())}</b>\n{flag} <b>ملک:</b> <b>{html.escape(safe_country.upper())}</b>\n{DIVIDER}\n"
    else:
        text = f"{PR_GEM} <b>NUMBER ALLOCATED</b> {PR_GEM}\n{DIVIDER}\n{srv_emoji} <b>SERVICE:</b> <b>{html.escape(service_info.get('service_name', '').upper())}</b>\n{flag} <b>COUNTRY:</b> <b>{html.escape(safe_country.upper())}</b>\n{DIVIDER}\n"
        
    for i, num_data in enumerate(numbers):
        raw_num = str(num_data['number']).replace('+', '')
        text += f"{i+1}️⃣ <code>+{raw_num}</code>  {num_data['status']}\n"
    text += f"{DIVIDER}\n{PR_FIRE} <b>{html.escape(watermark.upper())}</b> {PR_FIRE}"
    
    markup = InlineKeyboardMarkup(row_width=2)
    btn_chg = "🔄 CHANGE"
    btn_otp = "📨 OTP GROUP"
    btn_back = "🔙 BACK"
    
    if lang == "bn":
        btn_chg = "🔄 পরিবর্তন করুন"
        btn_otp = "📨 ওটিপি গ্রুপ"
        btn_back = "🔙 ফিরে যান"
    elif lang == "hi":
        btn_chg = "🔄 बदलें"
        btn_otp = "📨 OTP ग्रुप"
        btn_back = "🔙 वापस जाएं"
    elif lang == "ur":
        btn_chg = "🔄 تبدیل کریں"
        btn_otp = "📨 OTP گروپ"
        btn_back = "🔙 واپس جائیں"
    
    markup.add(ibtn(btn_chg, callback_data=f"chg_r|{service_info.get('srv_id', '')}|{service_info.get('cnt_id', '')}|{service_info.get('id', '')}", style="primary"), ibtn(btn_otp, url=main_link, style="success"))
    markup.add(ibtn(btn_back, callback_data=f"usr_s|{service_info.get('srv_id', '')}", style="danger"))
    safe_send(chat_id, text, markup, message_id)

def poll_otp(chat_id, num_data, service_info):
    number_id = num_data["number_id"]
    phone_number = num_data["number"]
    api_key = num_data["api_key"]
    headers = {'mauthapi': api_key}
    timeout = 600
    start_time = time.time()
    
    lang = get_user_lang(chat_id)
    
    while time.time() - start_time < timeout:
        if str(chat_id) not in active_polls or not active_polls[str(chat_id)]: return 
        try:
            res = requests.get(f"{BASE_URL}/otps", headers=headers, timeout=15)
            s_data = res.json()
            if s_data.get("meta", {}).get("code") == 200:
                otps = s_data.get("data", {}).get("otps", [])
                for otp_entry in otps:
                    if otp_entry.get("number") == phone_number:
                        otp_code = re.search(r'\b(\d{4,6})\b', otp_entry.get("message", ""))
                        if otp_code:
                            otp_code = otp_code.group(1)
                        else:
                            otp_code = "0000"
                        
                        full_sms = otp_entry.get("message", "")
                        app_name_from_api = service_info.get('service_name', '')
                        detected_service = detect_service_from_sms(full_sms, app_name_from_api)
                        
                        status_txt = "OTP RECEIVED"
                        if lang == "bn": status_txt = "ওটিপি পাওয়া গেছে"
                        elif lang == "hi": status_txt = "OTP मिल गया"
                        elif lang == "ur": status_txt = "OTP موصول ہو گیا"
                            
                        update_number_status(chat_id, phone_number, status_txt, "✅")
                        
                        # Anti-Cheat & Save System
                        unique_otp_id = f"{phone_number}_{otp_code}"
                        data = load_data()
                        dynamic_otp_bonus_usd = data.get("settings", {}).get("otp_bonus", OTP_BONUS)
                        
                        add_to_history(chat_id, detected_service, f"+{str(phone_number).replace('+', '')}", otp_code)
                        
                        data["otp_counts"][str(chat_id)] = data.get("otp_counts", {}).get(str(chat_id), 0) + 1
                        
                        if unique_otp_id not in data.get("processed_otps", []):
                            data.setdefault("processed_otps", []).append(unique_otp_id)
                            current_bal = data.get("balances", {}).get(str(chat_id), 0.0)
                            data.setdefault("balances", {})[str(chat_id)] = round(current_bal + dynamic_otp_bonus_usd, 5)
                            try:
                                b_amount = format_currency(dynamic_otp_bonus_usd, lang)
                                congrats = f"🎉 <b>CONGRATULATIONS!</b> You received <b>{b_amount}</b> for successful OTP extraction!"
                                if lang == "bn": congrats = f"🎉 <b>অভিনন্দন!</b> আপনি সফল ওটিপি উত্তোলনের জন্য <b>{b_amount}</b> পেয়েছেন!"
                                elif lang == "hi": congrats = f"🎉 <b>बधाई हो!</b> सफल OTP प्राप्ति के लिए आपको <b>{b_amount}</b> मिले हैं!"
                                elif lang == "ur": congrats = f"🎉 <b>مبارک ہو!</b> کامیاب OTP حاصل کرنے پر آپ کو <b>{b_amount}</b> ملے ہیں!"
                                    
                                bot.send_message(chat_id, congrats, parse_mode="HTML")
                            except: pass
                            
                        save_data(data)
                        
                        safe_country = clean_country_name(service_info['country_name'])
                        flag = get_country_flag(safe_country, premium=True)
                        srv_emoji = emo(detected_service)
                        disp_num = f"+{str(phone_number).replace('+', '')}"
                        
                        # Inbox Message Update
                        if lang == "bn":
                            inbox_msg = f"✨ <b>[ ওটিপি সফলভাবে পাওয়া গেছে ]</b> ✨\n{DIVIDER}\n📲 <b>সার্ভিস:</b> <b>{detected_service.upper()}</b>\n🌍 <b>দেশ:</b> {flag} <b>{html.escape(safe_country.upper())}</b>\n📞 <b>নাম্বার:</b> <code>{disp_num}</code>\n{THIN_DIVIDER}\n🔐 <b>আপনার ওটিপি কোড:</b>\n🎯 <code>{otp_code}</code> 🎯\n{DIVIDER}\n{PR_GEM} <b>{html.escape(data.get('watermark', BOT_NAME).upper())}</b> {PR_GEM}"
                        elif lang == "hi":
                            inbox_msg = f"✨ <b>[ OTP सफलतापूर्वक मिल गया ]</b> ✨\n{DIVIDER}\n📲 <b>सर्विस:</b> <b>{detected_service.upper()}</b>\n🌍 <b>देश:</b> {flag} <b>{html.escape(safe_country.upper())}</b>\n📞 <b>नंबर:</b> <code>{disp_num}</code>\n{THIN_DIVIDER}\n🔐 <b>आपका OTP कोड:</b>\n🎯 <code>{otp_code}</code> 🎯\n{DIVIDER}\n{PR_GEM} <b>{html.escape(data.get('watermark', BOT_NAME).upper())}</b> {PR_GEM}"
                        elif lang == "ur":
                            inbox_msg = f"✨ <b>[ OTP کامیابی سے حاصل کر لیا گیا ]</b> ✨\n{DIVIDER}\n📲 <b>سروس:</b> <b>{detected_service.upper()}</b>\n🌍 <b>ملک:</b> {flag} <b>{html.escape(safe_country.upper())}</b>\n📞 <b>نمبر:</b> <code>{disp_num}</code>\n{THIN_DIVIDER}\n🔐 <b>آپ کا OTP کوڈ:</b>\n🎯 <code>{otp_code}</code> 🎯\n{DIVIDER}\n{PR_GEM} <b>{html.escape(data.get('watermark', BOT_NAME).upper())}</b> {PR_GEM}"
                        else:
                            inbox_msg = f"✨ <b>[ OTP SUCCESSFULLY RETRIEVED ]</b> ✨\n{DIVIDER}\n📲 <b>SERVICE :</b> <b>{detected_service.upper()}</b>\n🌍 <b>REGION  :</b> {flag} <b>{html.escape(safe_country.upper())}</b>\n📞 <b>NUMBER  :</b> <code>{disp_num}</code>\n{THIN_DIVIDER}\n🔐 <b>YOUR OTP CODE:</b>\n🎯 <code>{otp_code}</code> 🎯\n{DIVIDER}\n{PR_GEM} <b>{html.escape(data.get('watermark', BOT_NAME).upper())}</b> {PR_GEM}"
                            
                        safe_send(chat_id, inbox_msg)
                        
                        # GROUP TICKET WITH SPECIFIC BUTTONS
                        masked_num = mask_number(phone_number)
                        group_msg = f"┏━━━━━━━━━━━━━━━━━━━━━━┓\n┣ 📲 <b>APP:</b> {srv_emoji} <b>{detected_service.upper()}</b>\n┣ 🌍 <b>REG:</b> {flag} <b>{safe_country.upper()}</b>\n┣ 📞 <b>NUM:</b> <code>{masked_num}</code>\n┗━━━━━━━━━━━━━━━━━━━━━━┛\n💎 <b>{html.escape(data.get('watermark', BOT_NAME).upper())}</b> 💎"
                        
                        bot_link = f"https://t.me/{BOT_USERNAME}" if BOT_USERNAME else "https://t.me/"
                        channel_link = data.get("force_join_channels", ["https://t.me/"])[0] if data.get("force_join_channels") else bot_link
                        
                        for grp in data.get("forward_groups", []):
                            try:
                                grp_markup = InlineKeyboardMarkup(row_width=2)
                                
                                btn_cp = f"📋 COPY OTP: {otp_code}"
                                btn_gt = "📲 Get Number"
                                btn_jn = "📢 Join Channel"
                                btn_mn = "🔗 Main Channel"
                                
                                if HAS_COPY_BTN: grp_markup.add(ibtn(btn_cp, copy_text_str=otp_code, style="success"))
                                else: grp_markup.add(ibtn(btn_cp, callback_data=f"cp_{otp_code}", style="success"))
                                
                                grp_markup.add(
                                    ibtn(btn_gt, url=bot_link, style="success"),
                                    ibtn(btn_jn, url=channel_link, style="primary")
                                )
                                grp_markup.add(ibtn(btn_mn, url=channel_link, style="primary"))
                                
                                for btn in grp.get("buttons", []):
                                    grp_markup.add(ibtn(btn['name'].upper(), url=btn['url'], style="primary"))
                                    
                                safe_send(grp['chat_id'], group_msg, grp_markup)
                            except: pass
                        return 
        except: pass 
        time.sleep(3) 
        
    status_txt = "TIMEOUT"
    if lang == "bn": status_txt = "সময় শেষ"
    elif lang == "hi": status_txt = "समय समाप्त"
    elif lang == "ur": status_txt = "وقت ختم"
    update_number_status(chat_id, phone_number, status_txt, "⏰")

if __name__ == "__main__":
    print("💎 MINO X SMS BOT IS RUNNING SUCCESSFULLY 💎")
    bot.infinity_polling()