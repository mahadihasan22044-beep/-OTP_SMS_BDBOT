# --- CURRENCY CONVERSION RATES (1 USD to Local) ---
EXCHANGE_RATES = {"en": 1.0, "bn": 120.0, "hi": 83.0, "ur": 280.0}
CURRENCY_SYMBOLS = {"en": "$", "bn": "৳", "hi": "₹", "ur": "Rs"}

def format_currency(amount_usd, lang="en"):
    rate = EXCHANGE_RATES.get(lang, 1.0)
    sym = CURRENCY_SYMBOLS.get(lang, "$")
    converted = float(amount_usd) * rate
    if converted == 0:
        return f"{sym}0.00"
    elif converted < 0.01:
        return f"{sym}{converted:.4f}"
    else:
        return f"{sym}{converted:.2f}"

def convert_to_usd(amount_local, lang="en"):
    rate = EXCHANGE_RATES.get(lang, 1.0)
    return float(amount_local) / rate

