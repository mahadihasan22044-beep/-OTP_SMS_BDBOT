    elif lang == "ur":
        text = f"🏆 <b>لیڈر بورڈ اور OTP کی تعداد</b> 🏆\n{DIVIDER}\n{l_text.upper()}\n\n🎯 <b>آپ کے کل OTPs: {user_otp_count}</b>\n\n📊 <b>سرفہرست 10 صارفین:</b>\n{board_text}{DIVIDER}\n{PR_GEM} <b>{watermark}</b> {PR_GEM}"
