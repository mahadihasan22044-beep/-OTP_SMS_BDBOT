def process_2fa_code(message, msg_id):
    if check_cancel(message, msg_id, show_2fa_menu): return
    
    try: bot.delete_message(message.chat.id, msg_id)
    except: pass
        
    secret_key = message.text.strip().upper().replace(" ", "")
    lang = get_user_lang(message.chat.id)
    
    if len(secret_key) < 8:
        err = "❌ <b>INVALID KEY! KEY TOO SHORT.</b>"
        if lang == "bn": err = "❌ <b>ভুল কী! কী খুব ছোট।</b>"
        elif lang == "hi": err = "❌ <b>अमान्य की! की बहुत छोटी है।</b>"
        elif lang == "ur": err = "❌ <b>غلط کی! کی بہت چھوٹی ہے۔</b>"
            
        bot.send_message(message.chat.id, err, parse_mode="HTML")
        show_2fa_menu(message.chat.id, None); return
    try:
        totp = pyotp.TOTP(secret_key)
        code = totp.now()
        remaining = 30 - (int(time.time()) % 30)
        
        if lang == "bn":
            text = f"🔴 <b><i><u>আপনার নিরাপদ 2FA কোড</u></i></b> 🔴\n\n<b><i><u>কোড:</u></i></b> <code>{code}</code>\n\n<b><i><u>মেয়াদ:</u></i></b> <b><i><u>{remaining} সেকেন্ড</u></i></b>"
            btn_copy = f"📋 কপি: {code}"
            btn_new = "🔄 নতুন কোড"
            btn_cls = "❌ বন্ধ করুন"
        elif lang == "hi":
            text = f"🔴 <b><i><u>आपका सुरक्षित 2FA कोड</u></i></b> 🔴\n\n<b><i><u>कोड:</u></i></b> <code>{code}</code>\n\n<b><i><u>समाप्त होगा:</u></i></b> <b><i><u>{remaining} सेकंड में</u></i></b>"
            btn_copy = f"📋 कॉपी: {code}"
            btn_new = "🔄 नया कोड"
            btn_cls = "❌ बंद करें"
        elif lang == "ur":
            text = f"🔴 <b><i><u>آپ کا محفوظ 2FA کوڈ</u></i></b> 🔴\n\n<b><i><u>کوڈ:</u></i></b> <code>{code}</code>\n\n<b><i><u>ختم ہوگا:</u></i></b> <b><i><u>{remaining} سیکنڈز میں</u></i></b>"
            btn_copy = f"📋 کاپی: {code}"
            btn_new = "🔄 نیا کوڈ"
            btn_cls = "❌ بند کریں"
        else:
            text = f"🔴 <b><i><u>YOUR SECURE 2FA CODE</u></i></b> 🔴\n\n<b><i><u>CODE:</u></i></b> <code>{code}</code>\n\n<b><i><u>EXPIRES IN:</u></i></b> <b><i><u>{remaining}S</u></i></b>"
            btn_copy = f"📋 COPY: {code}"
            btn_new = "🔄 NEW CODE"
            btn_cls = "❌ CLOSE"
            
        markup = InlineKeyboardMarkup(row_width=1)
        if HAS_COPY_BTN: markup.add(ibtn(btn_copy, copy_text_str=code, style="success"))
        else: markup.add(ibtn(btn_copy, callback_data=f"cp_{code}", style="success"))
        markup.add(ibtn(btn_new, callback_data="2fa_generate", style="primary"))
        markup.add(ibtn(btn_cls, callback_data="2fa_back", style="danger"))
        safe_send(message.chat.id, text, markup, None)
    except:
        err = "❌ <b>INVALID 2FA KEY!</b>"
        if lang == "bn": err = "❌ <b>ভুল 2FA কী!</b>"
        elif lang == "hi": err = "❌ <b>अमान्य 2FA की!</b>"
        elif lang == "ur": err = "❌ <b>غلط 2FA کی!</b>"
            
        bot.send_message(message.chat.id, err, parse_mode="HTML")
        show_2fa_menu(message.chat.id, None)

