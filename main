def show_referral_menu(chat_id, message_id=None):
    data = load_data()
    lang = get_user_lang(chat_id)
    l = LANG_DICT.get(lang, LANG_DICT["en"])
    dynamic_ref_bonus = data.get("settings", {}).get("ref_bonus", REF_BONUS)
    ref_link = f"https://t.me/{BOT_USERNAME}?start=ref_{chat_id}" if BOT_USERNAME else "N/A"
    
    referrals = [uid for uid, ref_id in data.get("referred_by", {}).items() if str(ref_id) == str(chat_id)]
    total_refs = len(referrals)
    active_refs = len([uid for uid in referrals if uid in data.get("referral_paid", [])])
    total_earned = active_refs * dynamic_ref_bonus
    
    text = f"{PR_STAR} <b>{l['btn_referral'].replace('🎁 ', '')}</b> {PR_STAR}\n{DIVIDER}\n"
    if lang == "bn":
        text += f"আপনার লিংক শেয়ার করুন এবং প্রতি অ্যাক্টিভ ইউজারের জন্য <b>{format_currency(dynamic_ref_bonus, lang)}</b> আয় করুন!\n\n"
        text += f"🔗 <b>আপনার রেফারেল লিংক:</b>\n<code>{ref_link}</code>\n\n"
        text += f"👥 <b>মোট রেফারেল:</b> {total_refs}\n"
        text += f"✅ <b>অ্যাক্টিভ রেফারেল:</b> {active_refs}\n"
        text += f"💰 <b>মোট আয়:</b> {format_currency(total_earned, lang)}\n"
        btn_text = "📋 লিংক কপি করুন"
    elif lang == "hi":
        text += f"अपना लिंक शेयर करें और हर एक्टिव यूज़र के लिए <b>{format_currency(dynamic_ref_bonus, lang)}</b> कमाएं!\n\n"
        text += f"🔗 <b>आपका रेफ़रल लिंक:</b>\n<code>{ref_link}</code>\n\n"
        text += f"👥 <b>कुल रेफ़रल:</b> {total_refs}\n"
        text += f"✅ <b>एक्टिव रेफ़रल:</b> {active_refs}\n"
        text += f"💰 <b>कुल कमाई:</b> {format_currency(total_earned, lang)}\n"
        btn_text = "📋 लिंक कॉपी करें"
    elif lang == "ur":
        text += f"اپنا لنک شیئر کریں اور ہر فعال صارف کے لیے <b>{format_currency(dynamic_ref_bonus, lang)}</b> کمائیں!\n\n"
        text += f"🔗 <b>آپ کا ریفرل لنک:</b>\n<code>{ref_link}</code>\n\n"
        text += f"👥 <b>کل ریفرل:</b> {total_refs}\n"
        text += f"✅ <b>فعال ریفرل:</b> {active_refs}\n"
        text += f"💰 <b>کل کمائی:</b> {format_currency(total_earned, lang)}\n"
        btn_text = "📋 لنک کاپی کریں"
    else:
        text += f"Share your link and earn <b>{format_currency(dynamic_ref_bonus, lang)}</b> for every active user that joins!\n\n"
        text += f"🔗 <b>YOUR REFERRAL LINK:</b>\n<code>{ref_link}</code>\n\n"
        text += f"👥 <b>Total Referrals:</b> {total_refs}\n"
        text += f"✅ <b>Active Referrals:</b> {active_refs}\n"
        text += f"💰 <b>Total Earned:</b> {format_currency(total_earned, lang)}\n"
        btn_text = "📋 COPY LINK"
        
    text += f"{DIVIDER}"
    
    markup = InlineKeyboardMarkup()
    if HAS_COPY_BTN:
        markup.add(ibtn(btn_text, copy_text_str=ref_link, style="success"))
    else:
        markup.add(ibtn(btn_text, callback_data=f"cp_{ref_link}", style="success"))
        
    safe_send(chat_id, text, markup, message_id)

def show_profile_withdraw(chat_id, message_id=None):
    data = load_data()
    lang = get_user_lang(chat_id)
    l = LANG_DICT.get(lang, LANG_DICT["en"])
    uid_str = str(chat_id)
    bal_usd = data.get("balances", {}).get(uid_str, 0.0)
    otp_count = data.get("otp_counts", {}).get(uid_str, 0)
    w_text = data.get("settings", {}).get("withdraw", "WITHDRAWAL INFO")
    watermark = data.get("watermark", BOT_NAME)
    
    profile = data.get("user_profiles", {}).get(uid_str, {})
    name = profile.get("first_name", "Unknown")
    username = profile.get("username", "N/A")
    username_str = f"@{username}" if username != "N/A" else "N/A"
    
    tier = get_user_tier(otp_count)
    
    u_wallets = data.get("wallets", {}).get(uid_str, {})
    wallet_display = ""
    for w_type in ["bkash", "nagad", "rocket", "binance", "easypaisa", "jazzcash", "paytm", "upi"]:
        if w_type in u_wallets:
            wallet_display += f"✅ <b>{w_type.upper()}:</b> <code>{u_wallets[w_type]}</code>\n"
            
    if not wallet_display:
        if lang == "bn": wallet_display = "<i>কোনো ওয়ালেট যুক্ত করা হয়নি।</i>\n"
        elif lang == "hi": wallet_display = "<i>कोई वॉलेट नहीं जोड़ा गया।</i>\n"
        elif lang == "ur": wallet_display = "<i>کوئی والیٹ شامل نہیں کیا گیا۔</i>\n"
        else: wallet_display = "<i>NO WALLETS ADDED YET.</i>\n"
    
    text = f"👤 <b>{l['profile_hdr']}</b> 👤\n{DIVIDER}\n📛 <b>{l['name']}:</b> {html.escape(name)}\n🔗 <b>{l['username']}:</b> {username_str}\n🆔 <b>{l['user_id']}:</b> <code>{chat_id}</code>\n🎖️ <b>{l['tier']}:</b> {tier}\n{THIN_DIVIDER}\n💵 <b>{l['current_balance']}:</b> <b>{format_currency(bal_usd, lang)}</b>\n🎯 <b>{l['total_otps']}:</b> {otp_count}\n{THIN_DIVIDER}\n🏦 <b>{l['saved_wallets']}:</b>\n{wallet_display}\n🏦 <b>{l['withdraw_info']}:</b>\n<i>{w_text.upper()}</i>\n{DIVIDER}\n<b>{l['manage_wallets']}:</b>\n{DIVIDER}\n{PR_GEM} <b>{watermark}</b> {PR_GEM}"
    
    markup = InlineKeyboardMarkup(row_width=2)
    markup.add(
        ibtn(l["refresh_prof"], callback_data="refresh_profile", style="primary"),
        ibtn(l["recent_otps_btn"], callback_data="recent_otps", style="success")
    )
    markup.add(ibtn(l["req_with_btn"], callback_data="req_withdraw", style="success"))
    
    wallet_options = ["bkash", "nagad", "rocket", "binance"]
    if lang == "hi": wallet_options = ["paytm", "upi", "binance"]
    elif lang == "ur": wallet_options = ["easypaisa", "jazzcash", "binance"]
        
    for w_type in wallet_options:
        if w_type in u_wallets:
            markup.add(
                ibtn(f"✏️ CHANGE {w_type.upper()}", callback_data=f"set_wallet_{w_type}", style="primary"),
                ibtn(f"🗑️ DEL {w_type.upper()}", callback_data=f"del_wallet_{w_type}", style="danger")
            )
        else:
            markup.add(ibtn(f"💳 ADD {w_type.upper()}", callback_data=f"set_wallet_{w_type}", style="success"))
            
    safe_send(chat_id, text, markup, message_id)

