def process_add_cnt(message, srv_id, msg_id):
    if check_cancel(message, msg_id, show_admin_countries, srv_id): return
    data = load_data()
    cnt_id = "c_" + str(uuid.uuid4())[:8]
    if srv_id in data.get("services_data", {}): 
        # Clean incoming name so admin mistakes won't cause bugs later
        safe_name = clean_country_name(message.text.upper())
        data["services_data"][srv_id]["countries"][cnt_id] = {"name": safe_name, "ranges": {}}; 
        save_data(data)
    try: bot.delete_message(message.chat.id, msg_id)
    except: pass
    show_admin_countries(message.chat.id, srv_id, None)

