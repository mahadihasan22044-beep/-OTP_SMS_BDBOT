def show_traffic_search(chat_id, message_id=None):
    lang = get_user_lang(chat_id)
    l = LANG_DICT.get(lang, LANG_DICT["en"])
    btn_close = "❌ CLOSE"
    if lang == "bn": btn_close = "❌ বন্ধ করুন"
    elif lang == "hi": btn_close = "❌ बंद करें"
    elif lang == "ur": btn_close = "❌ بند کریں"
    
    markup = InlineKeyboardMarkup().add(ibtn(btn_close, callback_data="close_menu", style="danger"))
    text = f"📊 <b>{l['traffic_hdr']}</b> 📊\n{DIVIDER}\n<b>{l['traffic_desc']}</b>\n{DIVIDER}"
    if not message_id:
        msg = safe_send(chat_id, text, markup)
        if msg: bot.register_next_step_handler_by_chat_id(chat_id, process_api_traffic_search, msg.message_id)
    else:
        safe_send(chat_id, text, markup, message_id)
        bot.register_next_step_handler_by_chat_id(chat_id, process_api_traffic_search, message_id)

