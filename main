        else: board_text = "<i>NO OTP RECORDS YET.</i>\n"
        
    user_otp_count = otp_counts.get(str(chat_id), 0)
    
    if lang == "bn":
        text = f"🏆 <b>লিডারবোর্ড ও ওটিপি সংখ্যা</b> 🏆\n{DIVIDER}\n{l_text.upper()}\n\n🎯 <b>আপনার মোট ওটিপি: {user_otp_count}</b>\n\n📊 <b>শীর্ষ ১০ ব্যবহারকারী:</b>\n{board_text}{DIVIDER}\n{PR_GEM} <b>{watermark}</b> {PR_GEM}"
