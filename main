def get_force_join_menu():
    data = load_data()
    is_enabled = data.get("force_join_enabled", False)
    channels = data.get("force_join_channels", [])
    status_text = "🟢 ENABLED" if is_enabled else "🔴 DISABLED"
    markup = InlineKeyboardMarkup(row_width=1)
    markup.add(ibtn(f"TOGGLE: {status_text}", callback_data="toggle_force_join", style="success" if is_enabled else "danger"))
    for idx, link in enumerate(channels):
        markup.add(ibtn(f"❌ REMOVE: {link}", callback_data=f"delfjc_{idx}", style="danger"))
    markup.add(ibtn("➕ ADD CHANNEL", callback_data="add_fjc", style="success"))
    markup.add(ibtn("🔙 BACK", callback_data="back_to_admin", style="primary"))
    return markup

def get_group_settings_menu():
    data = load_data()
    markup = InlineKeyboardMarkup(row_width=1)
    otp_link = data.get("main_otp_link", "")
    markup.add(ibtn("🔗 SET OTP GROUP LINK", callback_data="set_main_otp_link", style="primary"))
    if otp_link and otp_link != "https://t.me/":
        markup.add(ibtn("🗑️ REMOVE OTP LINK", callback_data="del_main_otp_link", style="danger"))
    markup.add(ibtn("➕ ADD FORWARD GROUP", callback_data="add_fwd_group", style="success"))
    fwd_groups = data.get("forward_groups", [])
    if fwd_groups:
        markup.add(ibtn("📋 ADDED GROUPS 📋", callback_data="ignore", style="primary"))
        for grp in fwd_groups:
            btn_count = len(grp.get('buttons', []))
            markup.add(ibtn(f"⚙️ {grp['chat_id']} [{btn_count} BTNS]", callback_data=f"editgrp_{grp['chat_id']}", style="primary"))
    markup.add(ibtn("🔙 BACK", callback_data="back_to_admin", style="danger"))
    return markup

def show_edit_group_menu(chat_id, grp_id, message_id=None):
    data = load_data()
    grp = next((g for g in data.get("forward_groups", []) if str(g["chat_id"]) == str(grp_id)), None)
    if not grp:
        safe_send(chat_id, f"🔗 <b>GROUP SETTINGS</b>", get_group_settings_menu(), message_id)
        return
    text = f"⚙️ <b>MANAGE GROUP</b>\n{DIVIDER}\n📱 <b>ID:</b> <code>{grp_id}</code>\n🔘 <b>BUTTONS:</b> {len(grp.get('buttons', []))}"
    markup = InlineKeyboardMarkup(row_width=1)
    for idx, btn in enumerate(grp.get("buttons", [])):
        markup.add(ibtn(f"❌ {btn['name'].upper()}", callback_data=f"delgrpbtn_{grp_id}_{idx}", style="danger"))
    markup.add(ibtn("➕ ADD BUTTON", callback_data=f"addgrpbtn_{grp_id}", style="success"))
    markup.add(ibtn("🗑️ DELETE GROUP", callback_data=f"delfwd_{grp_id}", style="danger"))
    markup.add(ibtn("🔙 BACK", callback_data="admin_group_settings", style="primary"))
    safe_send(chat_id, text, markup, message_id)

def process_withdraw_amount(message, msg_id, max_bal_usd):
    if check_cancel(message, msg_id, show_profile_withdraw): return
    
    try: bot.delete_message(message.chat.id, msg_id)
    except: pass
    
    lang = get_user_lang(message.chat.id)
    
    try:
        amt_local = float(message.text.strip())
        amt_usd = convert_to_usd(amt_local, lang)
        
        min_usd = 0.50
        if amt_usd < min_usd:
            err_msg = f"❌ <b>MINIMUM WITHDRAWAL IS {format_currency(min_usd, lang)}.</b>"
            if lang == "bn": err_msg = f"❌ <b>সর্বনিম্ন উত্তোলন {format_currency(min_usd, lang)}।</b>"
            elif lang == "hi": err_msg = f"❌ <b>न्यूनतम निकासी {format_currency(min_usd, lang)} है।</b>"
            elif lang == "ur": err_msg = f"❌ <b>کم از کم رقم نکلوانے کی حد {format_currency(min_usd, lang)} ہے۔</b>"
            bot.send_message(message.chat.id, err_msg, parse_mode="HTML")
            show_profile_withdraw(message.chat.id, None)
            return
            
        if amt_usd > max_bal_usd:
            err_msg = f"❌ <b>INSUFFICIENT BALANCE. (Max: {format_currency(max_bal_usd, lang)})</b>"
            if lang == "bn": err_msg = f"❌ <b>অপর্যাপ্ত ব্যালেন্স। (সর্বোচ্চ: {format_currency(max_bal_usd, lang)})</b>"
            elif lang == "hi": err_msg = f"❌ <b>अपर्याप्त बैलेंस। (अधिकतम: {format_currency(max_bal_usd, lang)})</b>"
            elif lang == "ur": err_msg = f"❌ <b>ناکافی بیلنس۔ (زیادہ سے زیادہ: {format_currency(max_bal_usd, lang)})</b>"
            bot.send_message(message.chat.id, err_msg, parse_mode="HTML")
            show_profile_withdraw(message.chat.id, None)
            return
            
        data = load_data()
        uid_str = str(message.chat.id)
        req_id = "wd_" + str(uuid.uuid4())[:8]
        
        # Deduct balance internally in USD
        data["balances"][uid_str] = round(max_bal_usd - amt_usd, 5)
        
        # Save withdrawal request in USD
        data.setdefault("pending_withdrawals", {})[req_id] = {
            "user_id": uid_str,
            "amount": amt_usd,
            "wallets": data.get("wallets", {}).get(uid_str, {}),
            "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        }
        save_data(data)
        
        # Notify User
        ok_msg = f"✅ <b>WITHDRAWAL REQUEST SENT!</b>\nAmount: <b>{format_currency(amt_usd, lang)}</b>\nPlease wait for admin approval."
        if lang == "bn": ok_msg = f"✅ <b>উত্তোলনের আবেদন পাঠানো হয়েছে!</b>\nপরিমাণ: <b>{format_currency(amt_usd, lang)}</b>\nঅনুগ্রহ করে এডমিন অনুমোদনের জন্য অপেক্ষা করুন।"
        elif lang == "hi": ok_msg = f"✅ <b>निकासी का अनुरोध भेजा गया!</b>\nराशि: <b>{format_currency(amt_usd, lang)}</b>\nकृपया एडमिन की मंज़ूरी का इंतज़ार करें।"
        elif lang == "ur": ok_msg = f"✅ <b>رقم نکلوانے کی درخواست بھیج دی گئی!</b>\nرقم: <b>{format_currency(amt_usd, lang)}</b>\nبراہ کرم ایڈمن کی منظوری کا انتظار کریں۔"
        
        bot.send_message(message.chat.id, ok_msg, parse_mode="HTML")
        show_profile_withdraw(message.chat.id, None)
        
        # Notify Admin (Always in USD)
        admin_msg = f"🔔 <b>NEW WITHDRAWAL REQUEST</b> 🔔\n{DIVIDER}\n"
        admin_msg += f"👤 <b>USER ID:</b> <code>{uid_str}</code>\n"
        admin_msg += f"💸 <b>AMOUNT:</b> <b>${amt_usd:.5f}</b>\n\n"
        admin_msg += "🏦 <b>USER WALLETS:</b>\n"
        for w, addr in data.get("wallets", {}).get(uid_str, {}).items():
            admin_msg += f"   - {w.upper()}: <code>{addr}</code>\n"
            
        admin_markup = InlineKeyboardMarkup(row_width=2)
        admin_markup.add(
            ibtn("✅ APPROVE", callback_data=f"adm_wd_app_{req_id}", style="success"),
            ibtn("❌ REJECT (REFUND)", callback_data=f"adm_wd_rej_{req_id}", style="danger")
        )
        safe_send(ADMIN_ID, admin_msg, admin_markup)
        
    except ValueError:
        err_msg = "❌ <b>INVALID AMOUNT FORMAT.</b>"
        if lang == "bn": err_msg = "❌ <b>ভুল পরিমাণের ধরন।</b>"
        elif lang == "hi": err_msg = "❌ <b>अमान्य राशि प्रारूप।</b>"
        elif lang == "ur": err_msg = "❌ <b>رقم کا فارمیٹ غلط ہے۔</b>"
        bot.send_message(message.chat.id, err_msg, parse_mode="HTML")
        show_profile_withdraw(message.chat.id, None)

# --- Callbacks ---
@bot.callback_query_handler(func=lambda call: True)
def handle_query(call):
    try: bot.answer_callback_query(call.id)
    except: pass
    bot.clear_step_handler_by_chat_id(call.message.chat.id)

    user_id = call.from_user.id
    if not is_user_allowed(user_id, call_id=call.id): return

    chat_id = call.message.chat.id
    msg_id = call.message.message_id
    data = load_data()
    api_key = data.get("api_key", NEXA_API_KEY)
    lang = get_user_lang(chat_id)
    
    if call.data == "ignore": return
    
    # Language Selection Callback
    if call.data.startswith("setlang_"):
        new_lang = call.data.split("_")[1]
        uid_str = str(chat_id)
        data.setdefault("user_profiles", {}).setdefault(uid_str, {})["lang"] = new_lang
        save_data(data)
        alert_msg = "✅ Language updated!"
        if new_lang == "bn": alert_msg = "✅ ভাষা আপডেট করা হয়েছে!"
        elif new_lang == "hi": alert_msg = "✅ भाषा अपडेट हो गई!"
        elif new_lang == "ur": alert_msg = "✅ زبان تبدیل کر دی گئی!"
            
        bot.answer_callback_query(call.id, alert_msg, show_alert=True)
        try: bot.delete_message(chat_id, msg_id)
        except: pass
        show_main_menu(chat_id, None)
        return
    
    # Profile Callbacks
    if call.data == "refresh_profile":
        ok_msg = "✅ Profile Updated Successfully!"
        if lang == "bn": ok_msg = "✅ প্রোফাইল সফলভাবে আপডেট হয়েছে!"
        elif lang == "hi": ok_msg = "✅ प्रोफ़ाइल सफलतापूर्वक अपडेट हो गई!"
        elif lang == "ur": ok_msg = "✅ پروفائل کامیابی سے اپ ڈیٹ ہو گیا!"
        bot.answer_callback_query(call.id, ok_msg, show_alert=True)
        show_profile_withdraw(chat_id, msg_id)
        return
    elif call.data == "recent_otps":
        show_recent_otps(chat_id, msg_id)
        return
    elif call.data == "back_to_profile":
        show_profile_withdraw(chat_id, msg_id)
        return
    elif call.data == "req_withdraw":
        data = load_data()
        uid_str = str(chat_id)
        bal_usd = data.get("balances", {}).get(uid_str, 0.0)
        min_usd = 0.50
        
        if bal_usd < min_usd:
            err = f"❌ MINIMUM WITHDRAWAL IS {format_currency(min_usd, lang)}!"
            if lang == "bn": err = f"❌ সর্বনিম্ন উত্তোলন {format_currency(min_usd, lang)}!"
            elif lang == "hi": err = f"❌ न्यूनतम निकासी {format_currency(min_usd, lang)} है!"
            elif lang == "ur": err = f"❌ کم از کم رقم نکلوانے کی حد {format_currency(min_usd, lang)} ہے!"
            bot.answer_callback_query(call.id, err, show_alert=True)
            return
            
        u_wallets = data.get("wallets", {}).get(uid_str, {})
        if not u_wallets:
            err = "❌ PLEASE ADD A WALLET FIRST!"
            if lang == "bn": err = "❌ প্রথমে একটি ওয়ালেট যোগ করুন!"
            elif lang == "hi": err = "❌ कृपया पहले वॉलेट जोड़ें!"
            elif lang == "ur": err = "❌ براہ کرم پہلے والیٹ شامل کریں!"
            bot.answer_callback_query(call.id, err, show_alert=True)
            return
            
        btn_cn = "🔙 CANCEL"
        if lang == "bn": btn_cn = "🔙 বাতিল করুন"
        elif lang == "hi": btn_cn = "🔙 रद्द करें"
        elif lang == "ur": btn_cn = "🔙 منسوخ کریں"
            
        markup = InlineKeyboardMarkup().add(ibtn(btn_cn, callback_data="back_to_profile", style="danger"))
        txt = f"💸 <b>SEND THE AMOUNT TO WITHDRAW (Min: {format_currency(min_usd, lang)}, Max: {format_currency(bal_usd, lang)}):</b>"
        if lang == "bn": txt = f"💸 <b>উত্তোলন করতে পরিমাণ লিখুন (সর্বনিম্ন: {format_currency(min_usd, lang)}, সর্বোচ্চ: {format_currency(bal_usd, lang)}):</b>"
        elif lang == "hi": txt = f"💸 <b>निकासी के लिए राशि भेजें (न्यूनतम: {format_currency(min_usd, lang)}, अधिकतम: {format_currency(bal_usd, lang)}):</b>"
        elif lang == "ur": txt = f"💸 <b>رقم نکلوانے کے لیے مقدار درج کریں (کم از کم: {format_currency(min_usd, lang)}، زیادہ سے زیادہ: {format_currency(bal_usd, lang)}):</b>"
            
        safe_send(chat_id, txt, markup, msg_id)
        bot.register_next_step_handler_by_chat_id(chat_id, process_withdraw_amount, msg_id, bal_usd)
        return
    
    # 2FA 
    if call.data == "2fa_back":
        try: bot.delete_message(chat_id, msg_id)
        except: pass
        return
    elif call.data == "2fa_generate":
        btn_cn = "🔙 CANCEL"
        if lang == "bn": btn_cn = "🔙 বাতিল করুন"
        elif lang == "hi": btn_cn = "🔙 रद्द करें"
        elif lang == "ur": btn_cn = "🔙 منسوخ کریں"
            
        markup = InlineKeyboardMarkup().add(ibtn(btn_cn, callback_data="2fa_back", style="danger"))
        if lang == "bn":
            text = f"🔴 <b><i><u>আপনার 2FA সিক্রেট কী লিখুন</u></i></b> 🔴\n\n<b><i><u>উদাহরণ: JBSWY3DPEHPK3PXP</u></i></b>\n\n<b><i><u>বন্ধ করতে /cancel লিখুন</u></i></b>"
        elif lang == "hi":
            text = f"🔴 <b><i><u>अपनी 2FA सीक्रेट की (Key) दर्ज़ करें</u></i></b> 🔴\n\n<b><i><u>उदाहरण: JBSWY3DPEHPK3PXP</u></i></b>\n\n<b><i><u>रोकने के लिए /cancel भेजें</u></i></b>"
        elif lang == "ur":
            text = f"🔴 <b><i><u>اپنی 2FA سیکرٹ کی (Key) درج کریں</u></i></b> 🔴\n\n<b><i><u>مثال: JBSWY3DPEHPK3PXP</u></i></b>\n\n<b><i><u>روکنے کے لیے /cancel بھیجیں</u></i></b>"
        else:
            text = f"🔴 <b><i><u>ENTER YOUR 2FA SECRET KEY</u></i></b> 🔴\n\n<b><i><u>EXAMPLE: JBSWY3DPEHPK3PXP</u></i></b>\n\n<b><i><u>SEND /cancel TO STOP</u></i></b>"
            
        safe_send(chat_id, text, markup, msg_id)
        bot.register_next_step_handler_by_chat_id(chat_id, process_2fa_code, msg_id)
        return
        
    # Wallet Settings
    if call.data.startswith("set_wallet_"):
        wallet_type = call.data.split("_")[2]
        btn_cn = "🔙 CANCEL"
        if lang == "bn": btn_cn = "🔙 বাতিল করুন"
        elif lang == "hi": btn_cn = "🔙 रद्द करें"
        elif lang == "ur": btn_cn = "🔙 منسوخ کریں"
            
        markup = InlineKeyboardMarkup().add(ibtn(btn_cn, callback_data="back_to_profile", style="danger"))
        txt = f"💳 <b>SEND YOUR {wallet_type.upper()} NUMBER/ADDRESS:</b>"
        if lang == "bn": txt = f"💳 <b>আপনার {wallet_type.upper()} নাম্বার/ঠিকানা লিখুন:</b>"
        elif lang == "hi": txt = f"💳 <b>अपना {wallet_type.upper()} नंबर/पता भेजें:</b>"
        elif lang == "ur": txt = f"💳 <b>اپنا {wallet_type.upper()} نمبر/پتہ بھیجیں:</b>"
            
        safe_send(chat_id, txt, markup, msg_id)
        bot.register_next_step_handler_by_chat_id(chat_id, process_save_wallet, wallet_type, msg_id)
        return
    if call.data.startswith("del_wallet_"):
        wallet_type = call.data.split("_")[2]
        uid_str = str(chat_id)
        if uid_str in data.get("wallets", {}) and wallet_type in data["wallets"][uid_str]:
            del data["wallets"][uid_str][wallet_type]
            save_data(data)
            bot.answer_callback_query(call.id, f"✅ {wallet_type.upper()} WALLET DELETED!", show_alert=True)
            show_profile_withdraw(chat_id, msg_id)
        return
    
    if call.data in ["main_get_number", "back_to_user_services"] or call.data.startswith("usr_s|") or call.data.startswith("usr_c|") or call.data.startswith("usr_auto_cnt|") or call.data.startswith("chg_r|"):
        if str(chat_id) in active_polls: 
            active_polls[str(chat_id)] = False 
        if not check_force_join(user_id):
            show_force_join_message(chat_id, msg_id)
            return
            
    if call.data == "check_join":
        if check_force_join(user_id):
            alert = f"✅ WELCOME TO {data.get('watermark', BOT_NAME)}!"
            if lang == "bn": alert = f"✅ {data.get('watermark', BOT_NAME)} এ স্বাগতম!"
            elif lang == "hi": alert = f"✅ {data.get('watermark', BOT_NAME)} में आपका स्वागत है!"
            elif lang == "ur": alert = f"✅ {data.get('watermark', BOT_NAME)} میں خوش آمدید!"
                
            bot.answer_callback_query(call.id, alert, show_alert=True)
            try: bot.delete_message(chat_id, msg_id)
            except: pass
            show_main_menu(chat_id, None) 
        else:
            alert = "❌ PLEASE JOIN THE CHANNEL FIRST!"
            if lang == "bn": alert = "❌ প্রথমে চ্যানেলে জয়েন করুন!"
            elif lang == "hi": alert = "❌ कृपया पहले चैनल से जुड़ें!"
            elif lang == "ur": alert = "❌ براہ کرم پہلے چینل میں شامل ہوں!"
                
            bot.answer_callback_query(call.id, alert, show_alert=True)
        return
        
    if call.data == "close_menu":
        try: bot.delete_message(chat_id, msg_id)
        except: pass
        return
    
    # --------------------------------------------
    # ADMIN PANEL ROUTES
    # --------------------------------------------
    if call.data.startswith("adm_") or call.data.startswith("admin_") or call.data.startswith("add_") or call.data.startswith("del_") or call.data.startswith("editgrp_") or call.data in ["admin_broadcast", "admin_group_settings", "admin_set_watermark", "admin_force_join", "toggle_force_join", "add_fjc", "back_to_admin", "admin_manage_service", "admin_export_data", "admin_edit_withdraw", "admin_edit_leadership", "admin_edit_support", "admin_edit_texts", "admin_backup_db", "admin_search_user"]:
        if user_id != ADMIN_ID: return safe_send(chat_id, f"⚠️ <b>ACCESS DENIED!</b>", None, msg_id)

    if call.data == "back_to_admin": show_admin_panel(chat_id, msg_id)
    
    # --- NEW CENTRALIZED USER SEARCH ---
    elif call.data == "admin_search_user":
        markup = InlineKeyboardMarkup().add(ibtn("🔙 CANCEL", callback_data="back_to_admin", style="danger"))
        safe_send(chat_id, f"🔍 <b>SEND USER ID TO MANAGE:</b>", markup, msg_id)
        bot.register_next_step_handler_by_chat_id(chat_id, process_admin_search_user, msg_id)

    # Admin Withdraw Action Handling
    elif call.data.startswith("adm_wd_app_"):
        req_id = call.data.replace("adm_wd_app_", "")
        data = load_data()
        req = data.get("pending_withdrawals", {}).get(req_id)
        if req:
            target_uid = req["user_id"]
            amt_usd = req["amount"]
            del data["pending_withdrawals"][req_id]
            save_data(data)
            bot.edit_message_text(f"{call.message.text}\n\n✅ <b>APPROVED BY ADMIN</b>", chat_id=chat_id, message_id=msg_id, parse_mode="HTML")
            t_lang = get_user_lang(target_uid)
            try:
                if t_lang == "bn": ok = f"🎉 <b>আপনার {format_currency(amt_usd, t_lang)} উত্তোলনের আবেদন অনুমোদিত হয়েছে এবং পাঠানো হয়েছে!</b>"
                elif t_lang == "hi": ok = f"🎉 <b>आपका {format_currency(amt_usd, t_lang)} निकासी अनुरोध मंज़ूर हो गया है और भेज दिया गया है!</b>"
                elif t_lang == "ur": ok = f"🎉 <b>آپ کی {format_currency(amt_usd, t_lang)} رقم نکلوانے کی درخواست منظور کر لی گئی ہے اور بھیج دی گئی ہے!</b>"
                else: ok = f"🎉 <b>YOUR WITHDRAWAL OF {format_currency(amt_usd, t_lang)} HAS BEEN APPROVED AND SENT!</b>"
                bot.send_message(target_uid, ok, parse_mode="HTML")
            except: pass
        else:
            bot.answer_callback_query(call.id, "❌ REQUEST NOT FOUND OR ALREADY PROCESSED.", show_alert=True)
            
    elif call.data.startswith("adm_wd_rej_"):
        req_id = call.data.replace("adm_wd_rej_", "")
        data = load_data()
        req = data.get("pending_withdrawals", {}).get(req_id)
        if req:
            target_uid = req["user_id"]
            amt_usd = req["amount"]
            current = data.get("balances", {}).get(target_uid, 0.0)
            data["balances"][target_uid] = round(current + amt_usd, 5)
            del data["pending_withdrawals"][req_id]
            save_data(data)
            
            bot.edit_message_text(f"{call.message.text}\n\n❌ <b>REJECTED & REFUNDED</b>", chat_id=chat_id, message_id=msg_id, parse_mode="HTML")
            t_lang = get_user_lang(target_uid)
            try:
                if t_lang == "bn": ok = f"⚠️ <b>আপনার {format_currency(amt_usd, t_lang)} উত্তোলনের আবেদন বাতিল করা হয়েছে।</b>\nব্যালেন্স আপনার অ্যাকাউন্টে ফেরত দেওয়া হয়েছে।"
                elif t_lang == "hi": ok = f"⚠️ <b>आपका {format_currency(amt_usd, t_lang)} निकासी अनुरोध रद्द कर दिया गया है।</b>\nफ़ंड आपके बैलेंस में वापस कर दिया गया है।"
                elif t_lang == "ur": ok = f"⚠️ <b>آپ کی {format_currency(amt_usd, t_lang)} کی درخواست مسترد کر دی گئی ہے۔</b>\nفنڈز آپ کے بیلنس میں واپس کر دیے گئے ہیں۔"
                else: ok = f"⚠️ <b>YOUR WITHDRAWAL OF {format_currency(amt_usd, t_lang)} WAS REJECTED.</b>\nFunds have been refunded to your balance."
                bot.send_message(target_uid, ok, parse_mode="HTML")
            except: pass
        else:
